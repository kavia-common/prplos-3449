{"is_source_file": true, "format": "C", "description": "This file is a Linux kernel driver source file for managing NVMEM (non-volatile memory) layout on MikroTik Routerboard devices. It defines functions and data structures to read and parse specific configuration data stored in device memory, including handling TLV (type-length-value) tags related to device configuration such as MAC addresses and hardware info.", "external_files": ["linux/bitfield.h", "linux/etherdevice.h", "linux/mod_devicetable.h", "linux/nvmem-consumer.h", "linux/nvmem-provider.h", "linux/of.h", "linux/platform_device.h", "rb_hardconfig.h", "routerboot.h"], "external_methods": ["nvmem_device_read", "nvmem_add_one_cell", "nvmem_layout_register", "nvmem_layout_unregister", "of_nvmem_layout_get_container", "of_get_child_by_name", "devm_kmalloc", "dev_err", "of_node_put", "MODULE_DEVICE_TABLE", "module_nvmem_layout_driver"], "published": ["rb_nvmem_layout"], "classes": [], "methods": [{"name": "const char * rb_tlv_cell_name(u16 tag)", "description": "Returns a string name corresponding to a given TLV tag value, mapping hardware configuration identifiers to human-readable names.", "scope": "", "scopeKind": ""}, {"name": "int rb_tlv_mac_read_cb(void * priv,const char * id,int index,unsigned int offset,void * buf,size_t bytes)", "description": "Callback function for reading MAC address data from the device's memory; it validates the address and adds it to the buffer.", "scope": "", "scopeKind": ""}, {"name": "nvmem_cell_post_process_t rb_tlv_read_cb(u16 tag)", "description": "Returns a pointer to a post-processing callback function based on the TLV tag, used after reading specific data types like MAC addresses.", "scope": "", "scopeKind": ""}, {"name": "int rb_add_cells(struct device * dev,struct nvmem_device * nvmem,const size_t data_len,u8 * data)", "description": "Parses the device's memory layout to extract configuration TLV entries and registers corresponding NVMEM cells.", "scope": "", "scopeKin